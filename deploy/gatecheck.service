[Unit]
Description=Gatecheck Bot (EVE Online gate monitoring)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gatecheck
Group=gatecheck
WorkingDirectory=/opt/gatecheck
ExecStart=/opt/gatecheck/.venv/bin/python main.py
Restart=always
RestartSec=5
# Слабый VPS: 1 ядро / 1 GB RAM — держим бота в рамках
MemoryMax=400M
CPUWeight=80
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
