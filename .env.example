# Gatecheck Bot — шаблон конфигурации. Скопируй в .env и заполни: `copy .env.example .env`

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# ID админов через запятую (для /ping); свой ID подскажет @userinfobot
ADMIN_IDS=

# Прокси для доступа к api.telegram.org (необязательно).
# Поддерживаются http:// и socks5:// (например, от локального проксификатора —
# v2rayN, Clash, Proxifier и т.п.):
#   PROXY_URL=socks5://127.0.0.1:1080
#   PROXY_URL=http://user:pass@127.0.0.1:8080
# Пусто или закомментировано — прямое соединение.
# PROXY_URL=

# --- Автономный прокси-пул (обход блокировок без ручного прокси) ---
# Порядок транспорта: PROXY_URL (если задан) → прямое соединение → пул.
# Пул сам добывает прокси из открытых списков, проверяет их реальным запросом
# к api.telegram.org, кэширует рабочие в data/proxy_cache.json и ротирует.
# PROXY_AUTOPOOL=1              # 0 — отключить пул (только PROXY_URL/прямое)
# PROXY_CHECK_TIMEOUT=8         # таймаут пробы одного прокси, сек
# PROXY_POOL_SIZE=20            # сколько рабочих прокси держать
# PROXY_CACHE=data/proxy_cache.json
# Свои прокси через разделитель | (приоритетнее списков):
# PROXY_MANUAL=socks5://1.2.3.4:1080 | vless://uuid@host:443?...#name
# Свои источники списков через запятую (по умолчанию — проверенные GitHub-списки):
# PROXY_SOURCES=https://raw.githubusercontent.com/hookzof/socks5_list/master/proxy.txt
# Диагностика пула без запуска бота:
#   .venv\Scripts\python -m gatecheck_bot.proxycheck
# SQLite (подписки/маршруты/kill-кэш переживают рестарт):
# DB_PATH=data/gatecheck.sqlite3